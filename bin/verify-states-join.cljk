#!/usr/bin/env nbb
(ns verify-states-join
  "Recompute the join declared in coverage/registry.edn :coverage/external-joins
  from the committed projection and the directory listing of the states
  repository, and fail when the registered numbers are stale.

  usage: nbb bin/verify-states-join.cljk <checkout of the states repository>

  Reads files only. It does not fetch, and it does not write: a join that
  drifted is a reviewed edit to coverage/registry.edn, not something this
  script repairs."
  (:require [clojure.string :as str]
            [edamame.core :as edn]))

(def fs (js/require "fs"))
(def path (js/require "path"))
(def crypto (js/require "crypto"))

(defn slurp* [p] (.toString (.readFileSync fs p)))
(defn sha256 [p] (-> (.createHash crypto "sha256") (.update (.readFileSync fs p)) (.digest "hex")))
(defn sha256-string [s] (-> (.createHash crypto "sha256") (.update (js/Buffer.from s)) (.digest "hex")))

(defn head-revision
  "The commit a checkout is at, read from .git without running git. nil when
  it cannot be read -- an unknown revision is reported as unknown, never
  assumed to be the locked one."
  [root]
  (let [head-file (.join path root ".git" "HEAD")]
    (when (.existsSync fs head-file)
      (let [head (.trim (slurp* head-file))]
        (if-let [[_ ref] (re-matches #"ref: (.+)" head)]
          (let [ref-file (.join path root ".git" ref)]
            (when (.existsSync fs ref-file) (.trim (slurp* ref-file))))
          head)))))

(def remote-root
  (or (first *command-line-args*)
      (throw (ex-info "usage: verify-states-join.cljk <states checkout>" {}))))

(let [registry (edn/parse-string (slurp* "coverage/registry.edn"))
      lock     (edn/parse-string (slurp* "sources.lock.edn"))
      join     (first (filter #(= :join/states-country-directories (:join/id %))
                              (:coverage/external-joins registry)))
      ;; The pin lives under :joins-unwired until the owner wires the states
      ;; checkout into .github/workflows/contract.yml; read both keys so the
      ;; script keeps working after the owner moves it to :joins.
      locked   (first (filter #(= (:join/id join) (:join/id %))
                              (concat (:joins lock) (:joins-unwired lock))))
      _        (assert join "coverage/registry.edn declares no :join/states-country-directories")
      _        (assert locked "sources.lock.edn pins no revision for :join/states-country-directories")
      _        (assert (= (:join/repository join) (:repository locked))
                       "registry and lock name different repositories for the join")
      revision (head-revision remote-root)
      _        (assert (or (nil? revision) (= revision (:revision locked)))
                       (str "states checkout is at " revision
                            ", the lock pins " (:revision locked)))
      local-file  "data/datascript-tx.edn"
      remote-dir  (.join path remote-root (:join/directory join))
      local-key   (:join/local-key join)
      local       (edn/parse-string (slurp* local-file))
      local-codes (set (keep local-key local))
      entries     (vec (.readdirSync fs remote-dir #js {:withFileTypes true}))
      remote-names (vec (sort (map #(.toUpperCase (.-name %))
                                   (filter #(.isDirectory %) entries))))
      remote      (set remote-names)
      measured {:remote-directories (count remote-names)
                :remote-not-three-letter (vec (filter #(not= 3 (count %)) remote-names))
                :matched (count (filter local-codes remote))
                :remote-unmatched (vec (sort (remove local-codes remote)))
                :local-distinct (count local-codes)
                :local-unmatched (count (remove remote local-codes))}]
  ;; Evidence floors. Every count below is a filter over a collection, and an
  ;; empty collection satisfies "nothing is unmatched" while joining nothing.
  (assert (pos? (count local-codes)) (str "no " local-key " values in " local-file))
  (assert (pos? (count remote-names)) (str "no directories under " remote-dir))
  (assert (= (count remote-names) (count remote))
          (str "directory names under " remote-dir " collide when upper-cased"))
  (assert (= (:join/measured join) measured)
          (str "coverage/registry.edn :join/measured is stale.\n registered: "
               (pr-str (:join/measured join)) "\n measured:   " (pr-str measured)))
  (println (pr-str {:status :ok
                    :join (:join/id join)
                    :local {:file local-file :sha256 (sha256 local-file)}
                    :remote {:repository (:join/repository join)
                             :directory (:join/directory join)
                             :listing-sha256 (sha256-string (str/join "\n" remote-names))
                             :revision (or revision :unknown)
                             :locked-revision (:revision locked)}
                    :measured measured})))
